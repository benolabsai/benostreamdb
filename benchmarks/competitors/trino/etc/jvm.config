-server
-agentpath:/usr/lib/trino/bin/libjvmkill.so
-XX:InitialRAMPercentage=80
-XX:MaxRAMPercentage=80
-XX:G1HeapRegionSize=32M
-XX:+ExplicitGCInvokesConcurrent
-XX:+HeapDumpOnOutOfMemoryError
-XX:+ExitOnOutOfMemoryError
-XX:-OmitStackTraceInFastThrow
-XX:ReservedCodeCacheSize=256M
-XX:PerMethodRecompilationCutoff=10000
-XX:PerBytecodeRecompilationCutoff=10000
-Djdk.attach.allowAttachSelf=true
-Djdk.nio.maxCachedBufferSize=2000000
-Dfile.encoding=UTF-8
-XX:+EnableDynamicAgentLoading
-Djava.security.manager=allow
# The BenoStreamDB connector loads its native library from here.
-Djava.library.path=/usr/lib/trino/lib
# Apache Arrow (Java) 14's MemoryUtil reflects into java.nio.DirectByteBuffer to
# allocate off-heap memory. Trino 468 runs on Java 23, where that reflection is
# denied by default ("Could not initialize class
# org.apache.arrow.memory.util.MemoryUtil"). Open the packages Arrow needs.
--add-opens=java.base/java.nio=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/sun.misc=ALL-UNNAMED
