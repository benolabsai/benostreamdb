# GPU benchmark runner: extends the CPU runner image with GPU-capable clients.
#
# Built automatically by docker_bench.sh --gpu / --both (service `bench-gpu`).
# Requires the NVIDIA Container Toolkit on the host.
FROM bsdb-bench-runner:latest

# faiss-gpu replaces faiss-cpu (both provide the `faiss` module).
RUN pip uninstall -y faiss-cpu || true
RUN pip install faiss-gpu-cu12

# GPU graph library (large). Enables the cuGraph graph competitor.
# Use the CUDA 13 build: the cu12 wheels have no Blackwell (sm_120) kernels, so
# on an RTX 50-series card they fail at CUDA context init with a misleading
# "cudaErrorMemoryAllocation: out of memory".
RUN pip install cugraph-cu13

WORKDIR /opt/bench
