# Benchmark runner image: contains the harness plus every competitor *client*.
#
# It runs with the SAME cgroup profile (--cpus/--memory) as the server engines
# and as BenoStreamDB, so every participant is measured under an identical
# envelope. See docker_bench.sh.
#
# Build:
#   docker build -f benchmarks/competitors/Dockerfile.bench -t bsdb-bench-runner .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# hnswlib has no manylinux wheel for every Python and builds from source, so a
# C++11 compiler is required.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Core numerics + ANN-Benchmarks I/O.
RUN pip install numpy h5py pandas pyarrow

# Competitor clients. faiss-cpu/hnswlib/lancedb/duckdb are embedded;
# psycopg/opensearch-py/neo4j/clickhouse-connect are clients for the compose
# services. tantivy is the embedded Rust IR library used by the BEIR lexical
# and hybrid baselines.
RUN pip install faiss-cpu hnswlib lancedb duckdb datafusion "psycopg[binary]" opensearch-py neo4j clickhouse-connect trino deltalake networkx scipy tantivy

WORKDIR /opt/bench
COPY benchmarks/competitors/run_competitor.py /opt/bench/run_competitor.py
COPY benchmarks/ann_benchmarks/run.py /opt/bench/ann_benchmarks.py
COPY benchmarks/iceberg_roundtrip/run.py /opt/bench/iceberg_roundtrip.py
COPY benchmarks/beir/run.py /opt/bench/beir_run.py
COPY benchmarks/beir/run_hybrid.py /opt/bench/beir_hybrid.py
COPY benchmarks/competitors/run_bench.sh /opt/bench/run_bench.sh
RUN chmod +x /opt/bench/run_bench.sh

# BenoStreamDB itself: install the abi3 wheel if one is mounted at /wheels.
# abi3 wheels built for >=3.10 load on 3.12, so the host `maturin build`
# output is reusable here (see docker_bench.sh).
RUN mkdir -p /wheels

ENTRYPOINT ["/bin/sh", "-lc"]
CMD ["/opt/bench/run_bench.sh"]
