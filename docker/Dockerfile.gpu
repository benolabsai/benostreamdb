# ---------------------------------------------------------------------------
# BenoStreamDB Multi-Flavor GPU Accelerated Services
# Supports NVIDIA CUDA, AMD ROCm, and Intel XPU / Vulkan backends
# ---------------------------------------------------------------------------
FROM rust:1.93-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    python3 \
    libpython3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace manifests for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY benostreamdb-flight/Cargo.toml benostreamdb-flight/Cargo.toml
COPY benostreamdb-search/Cargo.toml benostreamdb-search/Cargo.toml

# Create stub sources for dependency layer caching
RUN mkdir -p src \
    && echo "pub fn stub() {}" > src/lib.rs \
    && echo "fn main() {}" > build.rs \
    && mkdir -p benostreamdb-search/src \
    && echo "fn main() {}" > benostreamdb-search/src/main.rs \
    && echo "pub fn stub() {}" > benostreamdb-search/src/lib.rs \
    && mkdir -p benostreamdb-flight/src \
    && echo "fn main() {}" > benostreamdb-flight/src/main.rs \
    && mkdir -p tests/bin benches \
    && echo "fn main() {}" > tests/test_connector_ffi.rs \
    && echo "fn main() {}" > tests/bin/generate_iceberg_manifests.rs \
    && echo "fn main() {}" > tests/bin/verify_iceberg_read_check.rs \
    && echo "fn main() {}" > benches/performance.rs \
    && echo "fn main() {}" > benches/bench_table.rs \
    && cargo build --release -p benostreamdb-search -p benostreamdb-flight --features all-gpu \
    && rm -rf target/release/.fingerprint/benostreamdb* \
              target/release/deps/*benostreamdb* \
              target/release/deps/libbenostreamdb* \
              target/release/build/benostreamdb* \
              target/release/bsdb-search* \
              target/release/benostreamdb-flight*

# Copy actual source code
COPY build.rs ./
COPY src ./src
COPY benostreamdb-search/src ./benostreamdb-search/src
COPY benostreamdb-flight/src ./benostreamdb-flight/src

# Build both release binaries with all GPU acceleration features enabled
RUN cargo build --release -p benostreamdb-search -p benostreamdb-flight --features all-gpu


# ---------------------------------------------------------------------------
# Runtime: Ubuntu 22.04 with CUDA 12.4 runtime + Vulkan/Mesa drivers
# Supports:
#   - NVIDIA: CUDA 12.x driver/runtime + NVRTC JIT compilation
#   - AMD: Vulkan RADV driver (ROCm compatibility via /dev/kfd + /dev/dri)
#   - Intel: Vulkan ANV driver (Arc / Flex / Max compatibility via /dev/dri)
# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    python3 \
    libssl3 \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r benostream && useradd -r -g benostream -m benostream

WORKDIR /app

# Copy binaries and entrypoint script
COPY --from=builder /app/target/release/bsdb-search /usr/local/bin/bsdb-search
COPY --from=builder /app/target/release/benostreamdb-flight /usr/local/bin/benostreamdb-flight
COPY docker/quickstart-entrypoint.sh /usr/local/bin/quickstart-entrypoint.sh

RUN chmod +x /usr/local/bin/quickstart-entrypoint.sh \
    && mkdir -p /home/benostream/.benostreamdb/search \
    && chown -R benostream:benostream /home/benostream/.benostreamdb

# Expose ports: ES 7.10 (9200), Qdrant (6333), Flight SQL (50051), Prometheus (9090)
EXPOSE 9200 6333 50051 9090

# Container GPU passthrough settings for NVIDIA Container Toolkit
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Default network configuration
ENV BENOSEARCH_BIND=0.0.0.0
ENV BENOSEARCH_PORT=9200
ENV QDRANT_BIND=0.0.0.0
ENV QDRANT_PORT=6333
ENV FLIGHT_BIND=0.0.0.0
ENV FLIGHT_PORT=50051
ENV BENOSEARCH_DEVICE=auto
ENV RUST_LOG=info

USER benostream

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:9200/_cluster/health || exit 1

ENTRYPOINT ["quickstart-entrypoint.sh"]
CMD []
