test_c
test_prefetch
scratch_mem_test

# Blog article drafts (unpublished)
blog/articles/drafts/
# Quarantined pre-sweep benchmark artifacts (see benchmarks/run_sweep.py).
benchmarks/results/stale/
# Per-section quarantine archives of superseded competitor runs. They are the
# provenance trail for a report, not an input to it: the sweep reads
# `results/*.json` and the generator never looks inside `stale/`.
benchmarks/competitors/results/stale/

